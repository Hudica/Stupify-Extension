{
    "name": "Stupify Extension",
    "description": "Read docs like a human",
    "version": "0.1.0",
    "manifest_version": 3,
    "action": {
        "default_title": "Stupify",
        "default_icon": "stupify.png"
    },
    "side_panel": {
        "default_path": "side_panel.html"
    },
    "background": {
        "service_worker": "stupify_worker.js"
    },
    "permissions": ["sidePanel", "activeTab", "scripting"],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}